{
  "version": 1,
  "note": "Seed registry. Opt-out routes change often, so treat every entry as a lead, not gospel: `node privacy-agent/agent.mjs registry --verify` probes each URL live and stamps `probe` with what it actually got back. searchUrl patterns marked \"pattern-guess\" are inferred from public URL shapes and are the first thing to break.",
  "entries": [
    {
      "id": "truepeoplesearch",
      "name": "TruePeopleSearch",
      "host": "truepeoplesearch.com",
      "type": "broker",
      "region": "US",
      "exposes": ["street_address", "phone_number", "relatives", "age"],
      "searchUrl": "https://www.truepeoplesearch.com/results?name={nameQuery}&citystatezip={city}%2C+{state}",
      "searchUrlConfidence": "pattern-guess",
      "optOut": {
        "url": "https://www.truepeoplesearch.com/removal",
        "method": "web-form",
        "requires": ["listing URL", "email address for confirmation"],
        "notes": "Find your record first, paste its URL into the removal form, confirm from the emailed link."
      }
    },
    {
      "id": "fastpeoplesearch",
