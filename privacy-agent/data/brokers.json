      "searchUrl": "https://www.fastpeoplesearch.com/name/{firstLower}-{lastLower}_{citySlug}-{stateSlug}",
      "searchUrlConfidence": "pattern-guess",
      "optOut": {
        "url": "https://www.fastpeoplesearch.com/removal",
        "method": "web-form",
        "requires": ["listing URL", "email address for confirmation"],
        "notes": "Same operator family as TruePeopleSearch; removing from one does not remove from the other."
      }
    },
