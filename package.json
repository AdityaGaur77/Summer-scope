{
  "name": "summerscope",
  "version": "3.0.0",
  "description": "The complete database of summer programs and events for high school students",
  "type": "module",
  "scripts": {
    "dev": "npx serve .",
    "roll-cycle": "node scripts/roll-cycle.mjs",
    "privacy": "node privacy-agent/agent.mjs",
    "privacy:scan": "node privacy-agent/agent.mjs scan",
    "privacy:report": "node privacy-agent/agent.mjs report",
    "privacy:test": "node --test privacy-agent/test/agent.test.mjs privacy-agent/test/integration.test.mjs"
  },
  "devDependencies": {
    "serve": "^14.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "summer programs",
    "high school",
    "STEM",
    "hackathons",
    "college prep"
  ],
  "license": "MIT"
}
